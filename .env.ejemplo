# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Correo ---
# Gmail exige una "contraseña de aplicación", no la del correo:
# myaccount.google.com/apppasswords  (requiere verificación en dos pasos)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tucorreo@gmail.com
MAIL_FROM_NAME=Salas de apuestas

APP_NOMBRE=Salas de apuestas
URL_BASE=http://localhost:3000

# --- Sesión ---
# Mínimo 32 caracteres. En producción es obligatorio.
JWT_SECRETO=cambia-esto-por-algo-largo-y-aleatorio-de-verdad

# --- Base de datos ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=apuestas
PGUSER=postgres
PGPASSWORD=local123

# Solo si el servidor está DETRÁS de un proxy propio (Cloudflare, nginx).
# Sin proxy, la cabecera x-forwarded-for la puede falsificar cualquiera.
CONFIAR_EN_PROXY=false
